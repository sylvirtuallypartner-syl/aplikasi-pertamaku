# Diisi otomatis oleh Vercel setelah kamu sambungkan Postgres (Neon) di tab
# Storage project ini. Untuk development lokal, jalankan
# `vercel env pull .env.local` atau salin nilainya secara manual dari
# Vercel Project Settings > Environment Variables.
DATABASE_URL=

# Reminder notifikasi harian (opsional). Generate dengan:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY dan VAPID_PRIVATE_KEY = sepasang, dari output
# perintah di atas. CRON_SECRET bebas diisi string acak apa saja — Vercel
# otomatis mengirim header Authorization yang cocok ke /api/cron/reminder
# kalau variable ini diset.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

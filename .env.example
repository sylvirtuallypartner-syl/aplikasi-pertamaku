# Diisi otomatis oleh Vercel setelah kamu sambungkan Postgres (Neon) di tab
# Storage project ini. Untuk development lokal, jalankan
# `vercel env pull .env.local` atau salin nilainya secara manual dari
# Vercel Project Settings > Environment Variables.
DATABASE_URL=

# PIN untuk masuk ke tampilan Orang Tua (bebas berapa digit, mis. 4 digit).
# JANGAN commit nilai asli PIN ke git — isi ini hanya di .env.local (lokal)
# dan di Vercel Project Settings > Environment Variables (production).
PARENT_PIN=
